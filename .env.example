# Copy to .env for local runs. Everything here is optional — without a key
# the matching feature simply stays off. In Kubernetes these come from the
# scraper-secret Secret instead.

# Web-search discovery. Without it the "serper" source is skipped.
SERPER_API_KEY=

# Page fetching for search hits and for Cloudflare-fronted boards
# (jobs.bg/tech.bg). Without it those stay off and search hits are scored
# from their snippet only.
FIRECRAWL_API_KEY=

# Push new matches to Telegram. Both are needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Single shared password for the web UI. Empty means no authentication —
# fine on localhost, not on a public host.
SITE_PASSWORD=
